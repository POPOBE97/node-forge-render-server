// Hand-sculpted signed distance scene, all public coordinates bottom-left / Y-up.
// IQ distance primitives, smooth union and sphere tracing:
// https://iquilezles.org/articles/distfunctions/  https://iquilezles.org/articles/smin/
// No mesh or sampled image is involved in the portrait.

fn av_smin_avatar_sculpt(a: f32, b: f32, k: f32) -> f32 {
  let h = max(k - abs(a-b), 0.0) / k;
  return min(a,b) - h*h*k*0.25;
}
fn av_ellipsoid_avatar_sculpt(p: vec3f, r: vec3f) -> f32 {
  let a = length(p/r);
  return a*(a-1.0)/max(length(p/(r*r)), 0.00001);
}
fn av_capsule_avatar_sculpt(p: vec3f, a: vec3f, b: vec3f, r: f32) -> f32 {
  let v = b-a;
  return length(p-a-v*clamp(dot(p-a,v)/dot(v,v),0.0,1.0))-r;
}
fn av_ry_avatar_sculpt(p: vec3f, a: f32) -> vec3f {
  return vec3f(cos(a)*p.x+sin(a)*p.z,p.y,-sin(a)*p.x+cos(a)*p.z);
}
fn av_rx_avatar_sculpt(p: vec3f, a: f32) -> vec3f {
  return vec3f(p.x,cos(a)*p.y-sin(a)*p.z,sin(a)*p.y+cos(a)*p.z);
}
fn av_union_avatar_sculpt(a: vec2f, b: vec2f) -> vec2f { return select(b,a,a.x<b.x); }
fn av_bezier2_avatar_sculpt(p: vec2f, a: vec2f, b: vec2f, c: vec2f, d: vec2f) -> f32 {
  var dist = 100.0;
  var previous = a;
  for (var j=1; j<=12; j+=1) {
    let t=f32(j)/12.0;
    let u=1.0-t;
    let next=u*u*u*a+3.0*u*u*t*b+3.0*u*t*t*c+t*t*t*d;
    let v=next-previous;
    let q=p-previous-v*clamp(dot(p-previous,v)/max(dot(v,v),0.0000001),0.0,1.0);
    dist=min(dist,dot(q,q));
    previous=next;
  }
  return sqrt(dist);
}
fn av_path_avatar_sculpt(p: vec2f, points: array<vec2f,25>, count: u32) -> f32 {
  var pathPoints=points;
  var dist=100.0;
  var sign=1.0;
  var previous=pathPoints[0];
  for (var i=0u;i<count;i+=1u) {
    let a=pathPoints[3u*i]; let b=pathPoints[3u*i+1u];
    let c=pathPoints[3u*i+2u]; let d=pathPoints[3u*i+3u];
    for (var j=1;j<=16;j+=1) {
      let t=f32(j)/16.0; let u=1.0-t;
      let next=u*u*u*a+3.0*u*u*t*b+3.0*u*t*t*c+t*t*t*d;
      let e=next-previous;
      let w=p-previous;
      let bq=w-e*clamp(dot(w,e)/max(dot(e,e),0.0000001),0.0,1.0);
      dist=min(dist,dot(bq,bq));
      let crossesStart = p.y >= previous.y;
      let crossesEnd = p.y < next.y;
      let crossesEdge = e.x * w.y > e.y * w.x;
      let crossing = vec3<bool>(crossesStart, crossesEnd, crossesEdge);
      if (all(crossing)||all(!crossing)) { sign=-sign; }
      previous=next;
    }
  }
  return sign*sqrt(dist);
}
fn av_profile_avatar_sculpt(d: f32, z: f32, depth: f32, rounding: f32) -> f32 {
  let q=vec2f(max(d+rounding,0.0),z*rounding/depth);
  return (length(q)-rounding)*min(1.0,depth/rounding);
}
fn av_triangle_avatar_sculpt(p: vec2f,a: vec2f,b: vec2f,c: vec2f) -> f32 {
  let e0=b-a;let e1=c-b;let e2=a-c;
  let v0=p-a;let v1=p-b;let v2=p-c;
  let q0=v0-e0*clamp(dot(v0,e0)/dot(e0,e0),0.0,1.0);
  let q1=v1-e1*clamp(dot(v1,e1)/dot(e1,e1),0.0,1.0);
  let q2=v2-e2*clamp(dot(v2,e2)/dot(e2,e2),0.0,1.0);
  let cross0=e0.x*v0.y-e0.y*v0.x;
  let cross1=e1.x*v1.y-e1.y*v1.x;
  let cross2=e2.x*v2.y-e2.y*v2.x;
  let inside=(cross0>=0.0&&cross1>=0.0&&cross2>=0.0)||(cross0<=0.0&&cross1<=0.0&&cross2<=0.0);
  return sqrt(min(dot(q0,q0),min(dot(q1,q1),dot(q2,q2))))*select(1.0,-1.0,inside);
}
fn av_lip_relief_avatar_sculpt(p: vec2f) -> f32 {
  let u=(p.x+0.015)/0.28;
  let upper=(p-vec2f(-0.015,0.440))/vec2f(0.235,0.037);
  let lower=(p-vec2f(-0.015,0.338))/vec2f(0.225,0.055);
  return (0.010*exp(-dot(upper,upper))+0.022*exp(-dot(lower,lower)))*(1.0-smoothstep(0.80,1.15,abs(u)));
}
fn av_hand_surface_avatar_sculpt(p: vec2f) -> f32 {
  let u=clamp((p.x-0.86)/0.33,0.0,1.0);
  let y1= -0.29-0.055*u*u;let y2= -0.38-0.050*u*u;let y3= -0.47-0.060*u*u;
  let fingers=exp(-pow((p.y-y1)/0.037,2.0))+exp(-pow((p.y-y2)/0.037,2.0))+exp(-pow((p.y-y3)/0.040,2.0));
  return 1.02-0.30*pow((p.x-0.92)/0.55,2.0)+0.025*fingers*smoothstep(0.75,0.88,p.x);
}
fn av_front_offset_avatar_sculpt(y: f32) -> f32 {
  let q=(y-0.36)/0.49;
  return 0.15*exp(-q*q);
}
fn av_face_z_avatar_sculpt(p: vec2f) -> f32 {
  let q=vec2f((p.x+0.04)/1.02,(p.y-1.17)/1.24);
  let cheekL=(p-vec2f(-0.48,0.63))/vec2f(0.40,0.34);
  let cheekR=(p-vec2f(0.53,0.68))/vec2f(0.34,0.33);
  let socketL=(p-vec2f(-0.53,1.04))/vec2f(0.38,0.24);
  let socketR=(p-vec2f(0.54,1.10))/vec2f(0.36,0.24);
  let orbital=0.055*exp(-dot(cheekL,cheekL))+0.050*exp(-dot(cheekR,cheekR))
    -0.024*exp(-dot(socketL,socketL))-0.024*exp(-dot(socketR,socketR));
  return 0.86-0.31*q.x*q.x-0.15*q.y*q.y+0.045*exp(-pow((p.y-0.25)/0.35,2.0))+av_lip_relief_avatar_sculpt(p)+orbital;
}
fn av_nose_offset_avatar_sculpt(p: vec2f) -> f32 {
  let bridge=(p-vec2f(0.035,0.80))/vec2f(0.065,0.19);
  let tip=(p-vec2f(0.015,0.625))/vec2f(0.115,0.060);
  let wedge=av_triangle_avatar_sculpt(p,vec2f(-0.105,0.605),vec2f(0.125,0.635),vec2f(0.045,0.830));
  return 0.020*exp(-dot(bridge,bridge))+0.045*exp(-dot(tip,tip))
    +0.032*(1.0-smoothstep(-0.025,0.045,wedge));
}
fn av_curve_frame_avatar_sculpt(p: vec2f,a: vec2f,b: vec2f,c: vec2f,d: vec2f) -> vec2f {
  var previous=a; var best=100.0; var orientedDistance=100.0;
  for(var j=1;j<=24;j+=1){
    let t=f32(j)/24.0;let u=1.0-t;
    let next=u*u*u*a+3.0*u*u*t*b+3.0*u*t*t*c+t*t*t*d;
    let v=next-previous;let w=p-previous;
    let q=w-v*clamp(dot(w,v)/max(dot(v,v),0.000001),0.0,1.0);
    let d2=dot(q,q);
    if(d2<best){best=d2;orientedDistance=select(-sqrt(d2),sqrt(d2),v.x*w.y-v.y*w.x>0.0);}
    previous=next;
  }
  return vec2f(sqrt(best),orientedDistance);
}
fn av_lid_frame_avatar_sculpt(p: vec2f,upper: bool) -> vec2f {
  if(p.x<0.0){
    if(upper){return av_curve_frame_avatar_sculpt(p,av_eyeLeft[0],av_eyeLeft[1],av_eyeLeft[2],av_eyeLeft[3]);}
    return av_curve_frame_avatar_sculpt(p,av_eyeLeft[3],av_eyeLeft[4],av_eyeLeft[5],av_eyeLeft[6]);
  }
  if(upper){return av_curve_frame_avatar_sculpt(p,av_eyeRight[0],av_eyeRight[1],av_eyeRight[2],av_eyeRight[3]);}
  return av_curve_frame_avatar_sculpt(p,av_eyeRight[3],av_eyeRight[4],av_eyeRight[5],av_eyeRight[6]);
}
fn av_eye_surface_avatar_sculpt(p: vec2f) -> f32 {
  let center=select(vec2f(-0.565,0.965),vec2f(0.54,1.01),p.x>0.0);
  let q=(p-center)/select(vec2f(0.36,0.25),vec2f(0.34,0.25),p.x>0.0);
  return av_face_z_avatar_sculpt(p)-0.08+0.14*sqrt(max(1.0-dot(q,q),0.015));
}
fn av_eye_distance_avatar_sculpt(p: vec3f,d: f32) -> f32 {
  return max(d,abs(p.z-av_eye_surface_avatar_sculpt(p.xy)+0.06)-0.06);
}
fn av_lid_width_avatar_sculpt(p: vec2f) -> f32 {
  return select(mix(0.012,0.048,smoothstep(0.25,0.84,p.x))*(1.0-0.75*smoothstep(0.76,0.81,p.x)),
    mix(0.037,0.013,smoothstep(-0.50,-0.25,p.x)),p.x<0.0);
}
fn av_upper_height_avatar_sculpt(frame: vec2f,width: f32) -> f32 {
  if(frame.y>0.0){return 0.075*pow(max(1.0-pow(frame.x/0.100,2.0),0.0),2.0);}
  return 0.030+0.045*sqrt(max(1.0-pow(frame.x/width,2.0),0.0));
}
fn av_lower_height_avatar_sculpt(frame: vec2f) -> f32 {
  if(frame.y>0.0){return 0.016*pow(max(1.0-frame.x/0.040,0.0),2.0);}
  return 0.006+0.010*sqrt(max(1.0-pow(frame.x/0.004,2.0),0.0));
}
fn av_lids_avatar_sculpt(p: vec3f) -> vec2f {
  let up=av_lid_frame_avatar_sculpt(p.xy,true);let down=av_lid_frame_avatar_sculpt(p.xy,false);
  let z=av_face_z_avatar_sculpt(p.xy);
  let u=max(up.x-select(av_lid_width_avatar_sculpt(p.xy),0.100,up.y>0.0),
    (abs(p.z-z-av_upper_height_avatar_sculpt(up,av_lid_width_avatar_sculpt(p.xy))+0.035)-0.035)*0.7);
  let l=max(down.x-select(0.004,0.040,down.y>0.0),
    (abs(p.z-z-av_lower_height_avatar_sculpt(down)+0.020)-0.020)*0.7);
  return select(vec2f(l,15.0),vec2f(u,14.0),u<l);
}
fn av_eye_shadow_avatar_sculpt(p: vec3f) -> f32 {
  let light=normalize(vec3f(-0.45,0.90,1.4));
  var shade=1.0;var t=0.006;
  for(var i=0;i<12;i+=1){
    let d=av_lids_avatar_sculpt(p+light*t).x;
    shade=min(shade,7.0*d/t);
    t+=clamp(d,0.006,0.035);
    if(t>0.22){break;}
  }
  return 0.58+0.42*clamp(shade,0.0,1.0);
}
fn av_stroke_avatar_sculpt(p: vec3f, d: f32, width: f32, rise: f32, thickness: f32) -> f32 {
  return max(d-width,abs(p.z-av_face_z_avatar_sculpt(p.xy)-rise)-thickness);
}
fn av_lash_avatar_sculpt(p: vec2f) -> f32 {
  let left=av_capsule_avatar_sculpt(vec3f(p,0.0),vec3f(-0.98,1.10,0.0),vec3f(-0.83,1.04,0.0),0.014);
  let right=av_bezier2_avatar_sculpt(p,vec2f(0.73,1.18),vec2f(0.80,1.16),vec2f(0.86,1.17),vec2f(0.88,1.22))
    -(0.022*(1.0-smoothstep(0.76,0.88,p.x))+0.002);
  return min(left,right);
}

// Skin 1; hair 2; white 3; eyeliner 4; lips 5; mouth 6; shirt 7;
// collar/teeth 8; ear 9; glasses 10; frame 11; eyebrows 12; hand 13.
fn av_map_avatar_sculpt(p: vec3f, smile: f32, hairVolume: f32, glasses: f32) -> vec2f {
  let faceMask=av_path_avatar_sculpt(p.xy,av_face,av_face_count);
  let faceFront=av_face_z_avatar_sculpt(p.xy)+av_nose_offset_avatar_sculpt(p.xy)-0.07*exp(min(faceMask,0.0)/0.06);
  var head=max(faceMask,(abs(p.z+0.10)-faceFront-0.10)*0.72);
  let neckMask=av_path_avatar_sculpt(p.xy,av_neck,av_neck_count);
  let neckZ=0.32-0.32*pow((p.x+0.10)/0.60,2.0);
  let neck=max(neckMask,abs(p.z-neckZ+0.20)-0.20);
  head=min(head,neck);
  let ear=av_profile_avatar_sculpt(av_path_avatar_sculpt(p.xy,av_ear,av_ear_count),p.z-0.45,0.16,0.18);
  head=av_smin_avatar_sculpt(head,ear,0.06);
  if(p.y>0.70&&p.y<1.38&&abs(p.x)<1.0){
    let eyeCut=min(av_path_avatar_sculpt(p.xy,av_eyeLeft,av_eyeLeft_count),av_path_avatar_sculpt(p.xy,av_eyeRight,av_eyeRight_count));
    head=max(head,-max(eyeCut,av_face_z_avatar_sculpt(p.xy)-0.13-p.z));
  }
  var result=vec2f(head,1.0);

  let hp=vec3f(p.x/clamp(hairVolume,0.90,1.10),p.y,p.z);
  if (hp.y>-0.30 && hp.y<3.30 && hp.x>-1.90 && hp.x<1.30) {
    let left2=av_path_avatar_sculpt(hp.xy,av_left,av_left_count);
    let cap2=av_path_avatar_sculpt(hp.xy,av_part,av_part_count);
    let back2=av_path_avatar_sculpt(hp.xy,av_back,av_back_count);
    // Smooth swept front surfaces keep contour-medial axes out of the normals.
    let arch=0.18*exp(-pow((hp.y-1.55)/1.4,2.0));
    let sweep=av_bezier2_avatar_sculpt(hp.xy,vec2f(-0.13,2.92),vec2f(-1.18,2.50),vec2f(-1.65,0.85),vec2f(-0.98,-0.12));
    let mainFront=0.79+arch+0.12*exp(-sweep*sweep/0.15)-0.09*hp.x;
    let capFront=0.76+0.14*exp(-pow((hp.y-2.0)/0.9,2.0))-0.05*hp.x;
    let left=max(left2,(abs(hp.z-mainFront+0.20)-0.20+0.11*exp(min(left2,0.0)/0.055))*0.8);
    let cap=max(cap2,(abs(hp.z-capFront+0.20)-0.20+0.10*exp(min(cap2,0.0)/0.055))*0.8);
    let back=av_profile_avatar_sculpt(back2,hp.z+0.30,0.29,0.13);
    result=av_union_avatar_sculpt(result,vec2f(min(av_smin_avatar_sculpt(left,cap,0.04),back),2.0));
  }
  if (p.y>0.70 && p.y<1.38 && abs(p.x)<1.0 && p.z>0.18) {
    let eLeft=av_path_avatar_sculpt(p.xy,av_eyeLeft,av_eyeLeft_count);
    let eRight=av_path_avatar_sculpt(p.xy,av_eyeRight,av_eyeRight_count);
    result=av_union_avatar_sculpt(result,vec2f(av_eye_distance_avatar_sculpt(p,min(eLeft,eRight)),3.0));
    result=av_union_avatar_sculpt(result,av_lids_avatar_sculpt(p));
    let lash=av_lash_avatar_sculpt(p.xy);
    result=av_union_avatar_sculpt(result,vec2f(av_stroke_avatar_sculpt(p,lash,0.0,0.040,0.015),4.0));
  }
  if (p.y>1.30 && p.y<1.70 && abs(p.x)<1.0 && p.z>0.15) {
    let browD=min(av_path_avatar_sculpt(p.xy,av_browLeft,av_browLeft_count),av_path_avatar_sculpt(p.xy,av_browRight,av_browRight_count));
    result=av_union_avatar_sculpt(result,vec2f(av_stroke_avatar_sculpt(p,browD,0.0,0.012,0.009),12.0));
  }


  let shirtMask=av_path_avatar_sculpt(p.xy,av_shirt,av_shirt_count);
  let body=max(max(shirtMask,-neckMask),abs(p.z-0.03)-0.20);
  result=av_union_avatar_sculpt(result,vec2f(body,7.0));
  let collar=max(max(max(abs(neckMask-0.050)-0.050,shirtMask),p.y+0.33),abs(p.z-0.25)-0.025);
  result=av_union_avatar_sculpt(result,vec2f(collar,8.0));

  let handMask=av_path_avatar_sculpt(p.xy,av_hand,av_hand_count);
  let handFront=av_hand_surface_avatar_sculpt(p.xy);
  let hand=max(handMask,(abs(p.z-handFront+0.12)-0.12+0.03*exp(min(handMask,0.0)/0.03))*0.7);
  let otherHand=av_ellipsoid_avatar_sculpt(p-vec3f(1.63,-0.63,0.70),vec3f(0.28,0.30,0.10));
  result=av_union_avatar_sculpt(result,vec2f(min(hand,otherHand),13.0));

  if (glasses>0.5) {
    let q=vec3f(abs(p.x)-0.54,p.y-1.02,p.z-0.94);
    result=av_union_avatar_sculpt(result,vec2f(av_ellipsoid_avatar_sculpt(q,vec3f(0.43,0.31,0.045)),10.0));
    let ring=length(vec2f(length(q.xy/vec2f(1.38,1.0))-0.30,q.z))-0.028;
    let bridge=av_capsule_avatar_sculpt(p,vec3f(-0.13,1.10,0.98),vec3f(0.13,1.10,0.98),0.025);
    result=av_union_avatar_sculpt(result,vec2f(min(ring,bridge),11.0));
  }
  return result;
}
fn av_normal_avatar_sculpt(p: vec3f,s: f32,h: f32,g: f32) -> vec3f {
  var n=vec3f(0.0);
  for (var i=0u;i<4u;i+=1u) {
    let e=0.5773*(2.0*vec3f(f32(((i+3u)>>1u)&1u),f32((i>>1u)&1u),f32(i&1u))-1.0);
    n+=e*av_map_avatar_sculpt(p+0.001*e,s,h,g).x;
  }
  return normalize(n);
}
fn av_ao_avatar_sculpt(p: vec3f,n: vec3f,s: f32,h: f32,g: f32) -> f32 {
  var o=0.0; var weight=1.0;
  for (var i=1;i<=4;i+=1) {
    let d=0.035+0.055*f32(i);
    o+=weight*(d-av_map_avatar_sculpt(p+n*d,s,h,g).x);
    weight*=0.55;
  }
  return clamp(1.0-1.7*o,0.30,1.0);
}
fn av_shadow_avatar_sculpt(p: vec3f,l: vec3f,s: f32,h: f32,g: f32) -> f32 {
  var shade=1.0; var t=0.03;
  for (var i=0;i<18;i+=1) {
    let d=av_map_avatar_sculpt(p+l*t,s,h,g).x;
    shade=min(shade,5.0*d/t);
    t+=clamp(d,0.025,0.22);
    if(shade<0.01||t>3.0){break;}
  }
  return clamp(shade,0.0,1.0);
}
fn av_linear_avatar_sculpt(c: vec3f) -> vec3f {
  return select(c/12.92,pow((c+0.055)/1.055,vec3f(2.4)),c>vec3f(0.04045));
}
fn av_iris_local_avatar_sculpt(p: vec2f,gaze: f32) -> vec2f {
  if(p.x<0.0){return (p-vec2f(-0.43+gaze-0.06,0.940))/vec2f(0.165,0.180);}
  let q=p-vec2f(0.55+gaze-0.06,1.020);
  return vec2f(q.x-0.23*q.y,q.y)/vec2f(0.170,0.210);
}
fn av_shade_avatar_sculpt(p: vec3f,n: vec3f,rd: vec3f,id: f32,s: f32,h: f32,g: f32,gaze: f32,clay: f32) -> vec3f {
  if(clay < -1.5){return av_linear_avatar_sculpt(vec3f(id/16.0));}
  var color=vec3f(1.0,0.775,0.665);
  var shine=0.035; var exponent=40.0; var flesh=1.0;
  if(id==1.0||id==13.0) {
    let cheek=vec2f((abs(p.x)-0.62)/0.34,(p.y-0.71)/0.23);
    color=mix(color,vec3f(1.0,0.48,0.42),0.20*exp(-dot(cheek,cheek))*smoothstep(0.32,0.60,p.z));
    let nose=vec2f((p.x-0.025)/0.13,(p.y-0.64)/0.10);
    color=mix(color,vec3f(0.95,0.58,0.46),0.20*exp(-dot(nose,nose))*smoothstep(0.90,0.97,p.z));
  } else if(id==2.0||id==12.0) {
    flesh=0.0;
    color=vec3f(0.255,0.16,0.13);
    let flow=av_bezier2_avatar_sculpt(p.xy,vec2f(-0.13,2.92),vec2f(-1.18,2.50),vec2f(-1.65,0.85),vec2f(-0.98,-0.12));
    let flow2=av_bezier2_avatar_sculpt(p.xy,vec2f(-0.03,2.72),vec2f(-0.92,2.45),vec2f(-1.23,0.72),vec2f(-0.83,-0.12));
    let lock=av_bezier2_avatar_sculpt(p.xy,vec2f(0.24,2.54),vec2f(-0.40,3.00),vec2f(-1.44,2.38),vec2f(-1.73,1.10));
    let lock2=av_bezier2_avatar_sculpt(p.xy,vec2f(0.24,2.22),vec2f(-0.40,2.45),vec2f(-1.20,1.15),vec2f(-0.81,-0.14));
    color*=1.0+0.14*exp(-lock*lock/0.0025)+0.07*exp(-lock2*lock2/0.008);
    color*=1.0+0.07*exp(-flow*flow/0.004)-0.06*exp(-flow2*flow2/0.0008);
    shine=0.010; exponent=17.0;
    if(id==12.0){color=vec3f(0.38,0.25,0.20);shine=0.008;}
  } else if(id==3.0) {
    flesh=0.0; color=vec3f(0.96,0.95,0.955);
    let q=av_iris_local_avatar_sculpt(p.xy,gaze);
    let r=length(q);
    var iris=mix(vec3f(0.09,0.055,0.06),vec3f(0.36,0.185,0.115),clamp(0.50-0.70*q.y,0.0,1.0));
    iris=mix(iris,vec3f(0.105,0.052,0.040),smoothstep(0.82,0.98,r));
    color=mix(color,iris,1.0-smoothstep(0.96,1.0,r));
    let pupilCenter=vec2f(0.08,select(0.20,0.14,p.x>0.0));
    color=mix(color,vec3f(0.065,0.038,0.043),1.0-smoothstep(0.50,0.70,length((q-pupilCenter)/vec2f(1.0,1.08))));
    let glint=length((q-select(vec2f(-0.37,0.43),vec2f(-0.55,0.286),p.x>0.0))/select(vec2f(0.13,0.15),vec2f(0.11,0.12),p.x>0.0));
    color=mix(color,vec3f(1.0),1.0-smoothstep(0.7,1.0,glint));
    color=mix(color,vec3f(0.65,0.71,0.76),(1.0-smoothstep(0.04,0.095,length(q-vec2f(0.27,-0.30))))*0.08);
    let lidD=select(av_bezier2_avatar_sculpt(p.xy,av_eyeLeft[0],av_eyeLeft[1],av_eyeLeft[2],av_eyeLeft[3]),
      av_bezier2_avatar_sculpt(p.xy,av_eyeRight[0],av_eyeRight[1],av_eyeRight[2],av_eyeRight[3]),p.x>0.0);
    color*=mix(0.70,1.0,smoothstep(0.01,0.09,lidD));
    shine=0.02;exponent=100.0;
  } else if(id==14.0) {
    let side=av_lid_frame_avatar_sculpt(p.xy,true).y;
    let rim=smoothstep(av_lid_width_avatar_sculpt(p.xy)*0.65,av_lid_width_avatar_sculpt(p.xy)*1.35,side);
    color=mix(vec3f(0.085,0.052,0.050),vec3f(1.0,0.775,0.665),rim);
    flesh=rim;shine=0.015;exponent=30.0;
  } else if(id==15.0) {
    color=vec3f(1.0,0.775,0.665);flesh=1.0;shine=0.015;
  } else if(id==4.0) {color=vec3f(0.065,0.030,0.025);shine=0.005;flesh=0.0;
  } else if(id==5.0) {
    let u=(p.x+0.015)/0.27;
    let mid=0.38+0.05*u*u+0.015*u;
    color=mix(vec3f(1.0,0.60,0.52),vec3f(0.92,0.43,0.37),smoothstep(mid-0.008,mid+0.022,p.y));
    shine=0.035;
  } else if(id==6.0) {color=vec3f(0.64,0.29,0.22);shine=0.0;
  } else if(id==7.0) {color=vec3f(0.07,0.075,0.085);shine=0.015;exponent=12.0;flesh=0.0;
  } else if(id==8.0) {color=vec3f(0.96,0.95,0.93);shine=0.01;flesh=0.0;
  } else if(id==10.0) {color=vec3f(0.05,0.035,0.033)+0.12*smoothstep(1.0,1.3,p.y);shine=0.35;flesh=0.0;
  } else if(id==11.0) {color=vec3f(0.21,0.115,0.08);shine=0.15;flesh=0.0;}
  if(clay>0.5){color=vec3f(0.80,0.81,0.83);flesh=0.0;shine=0.03;}
  let base=av_linear_avatar_sculpt(color);
  let key=normalize(vec3f(-0.7,1.0,1.8));
  let fill=normalize(vec3f(0.9,0.15,1.1));
  let ao=1.0;
  let shadow=1.0;
  let diffuse=max(dot(n,key),0.0);
  let wrap=clamp((dot(n,key)+0.65)/1.65,0.0,1.0);
  let light=vec3f(0.56,0.54,0.53)*ao+vec3f(0.50,0.47,0.43)*mix(diffuse,wrap,0.70*flesh)*(0.60+0.40*shadow)
    +vec3f(0.11,0.12,0.15)*max(dot(n,fill),0.0)*ao;
  var out_color=base*light;
  out_color+=vec3f(1.0,0.88,0.78)*shine*pow(max(dot(n,normalize(key-rd)),0.0),exponent)*shadow;
  out_color+=base*vec3f(0.16,0.035,0.015)*flesh*pow(1.0-max(dot(n,-rd),0.0),2.0)*ao;
  if(clay> -0.5 && clay<0.5){
    var tone=vec3f(0.0);
    if(id==14.0){tone=av_tone_1_avatar_sculpt(p.xy)*smoothstep(av_lid_width_avatar_sculpt(p.xy)*0.65,av_lid_width_avatar_sculpt(p.xy)*1.35,av_lid_frame_avatar_sculpt(p.xy,true).y);}
    else if(id==15.0){tone=av_tone_1_avatar_sculpt(p.xy);}
    else{tone=av_tone_avatar_sculpt(p,id);}
    out_color*=exp(tone);
  }
  if(id==3.0){out_color*=av_eye_shadow_avatar_sculpt(p+vec3f(0.0,0.0,0.002));}
  if(id==1.0 && clay<0.5) {
    // Soft pigment boundaries follow a signed lip contour on the skin surface.
    let u=clamp((p.x-0.01)/0.29,-1.0,1.0);
    let round=sqrt(max(1.0-u*u,0.0));
    let seam=0.392+(0.032+0.015*(s-0.30))*u*u+0.024*pow(u,4.0)+0.012*u;
    let top=seam+0.068*round*(1.0-0.25*exp(-u*u/0.07));
    let bottom=seam-0.105*round;
    let d=max(abs(p.x-0.01)-0.29,max(p.y-top,bottom-p.y));
    let pigment=mix(vec3f(0.95,0.575,0.50),vec3f(0.96,0.445,0.405),smoothstep(seam-0.01,seam+0.025,p.y));
    out_color=mix(out_color,av_linear_avatar_sculpt(pigment)*(0.78+0.22*max(dot(n,key),0.0)),1.0-smoothstep(-0.035,0.035,d));
    let crease=exp(-pow((p.y-seam)/0.011,2.0))*(1.0-smoothstep(0.25,0.31,abs(p.x-0.01)));
    out_color=mix(out_color,av_linear_avatar_sculpt(vec3f(0.70,0.23,0.18)),crease*0.96);
    let lipShade=exp(-pow((p.x+0.015)/0.24,2.0)-pow((p.y-0.28)/0.055,2.0));
    out_color*=1.0-0.06*lipShade;
    let ns=(p.xy-vec2f(0.105,0.675))/vec2f(0.040,0.075);
    let under=(p.xy-vec2f(0.015,0.610))/vec2f(0.105,0.025);
    out_color*=1.0-0.18*exp(-dot(ns,ns))-0.12*exp(-dot(under,under));
  }
  if(id==13.0 && clay<0.5){
    let f1=av_bezier2_avatar_sculpt(p.xy,vec2f(0.86,-0.31),vec2f(0.97,-0.31),vec2f(1.11,-0.33),vec2f(1.18,-0.36));
    let f2=av_bezier2_avatar_sculpt(p.xy,vec2f(0.84,-0.39),vec2f(0.98,-0.40),vec2f(1.12,-0.42),vec2f(1.19,-0.45));
    let f3=av_bezier2_avatar_sculpt(p.xy,vec2f(0.80,-0.49),vec2f(0.95,-0.50),vec2f(1.13,-0.52),vec2f(1.20,-0.54));
    out_color*=1.0-0.12*exp(-pow(min(f1,min(f2,f3))/0.013,2.0));
  }
  if(id==3.0&&clay<0.5){
    let q=av_iris_local_avatar_sculpt(p.xy,gaze);
    let offset=select(vec2f(-0.37,0.43),vec2f(-0.55,0.286),p.x>0.0);
    let radius=select(vec2f(0.13,0.15),vec2f(0.11,0.12),p.x>0.0);
    let glint=1.0-smoothstep(0.45,1.0,length((q-offset)/radius));
    out_color=mix(out_color,vec3f(1.0,0.99,0.98),glint);
  }
  return max(out_color,vec3f(0.0));
}
// An orthographic ray along -Z has a closed-form intersection with these
// SDF height surfaces. Evaluate each contour once, avoiding a nested march.
fn av_front_avatar_sculpt(p: vec2f, h: f32, g: f32) -> vec2f {
  var hit=vec2f(-100.0,0.0);
  let faceD=av_path_avatar_sculpt(p,av_face,av_face_count);
  let faceZ=av_face_z_avatar_sculpt(p);
  if(faceD<0.0){hit=vec2f(faceZ+av_nose_offset_avatar_sculpt(p)-0.07*exp(faceD/0.06),1.0);}
  if(p.y<0.18) {
    let neckD=av_path_avatar_sculpt(p,av_neck,av_neck_count);
    let neckZ=0.32-0.32*pow((p.x+0.10)/0.60,2.0);
    if(neckD<0.0 && neckZ>hit.x){hit=vec2f(neckZ,1.0);}
    if(p.y< -0.28){
      let shirtD=av_path_avatar_sculpt(p,av_shirt,av_shirt_count);
      if(shirtD<0.0 && neckD>0.0 && 0.23>hit.x){hit=vec2f(0.23,7.0);}
      if(shirtD<0.0 && p.y< -0.33 && abs(neckD-0.050)<0.050 && 0.275>hit.x){hit=vec2f(0.275,8.0);}
    }
  }
  if(p.x>0.80 && p.y>0.60 && p.y<1.40){
    let d=av_path_avatar_sculpt(p,av_ear,av_ear_count);
    let z=0.45+0.16*sqrt(max(1.0-pow(max(d+0.18,0.0)/0.18,2.0),0.0));
    if(d<0.0){if(hit.y==1.0){hit.x= -av_smin_avatar_sculpt(-hit.x,-z,0.04);}else if(z>hit.x){hit=vec2f(z,1.0);}}
  }
  let hp=vec2f(p.x/clamp(h,0.9,1.1),p.y);
  if(hp.y> -0.30 && hp.y<3.30 && hp.x> -1.90 && hp.x<1.30){
    let leftD=av_path_avatar_sculpt(hp,av_left,av_left_count);
    let capD=av_path_avatar_sculpt(hp,av_part,av_part_count);
    let backD=av_path_avatar_sculpt(hp,av_back,av_back_count);
    let sweep=av_bezier2_avatar_sculpt(hp,vec2f(-0.13,2.92),vec2f(-1.18,2.50),vec2f(-1.65,0.85),vec2f(-0.98,-0.12));
    let mainZ=0.79+0.18*exp(-pow((hp.y-1.55)/1.4,2.0))+0.12*exp(-sweep*sweep/0.15)-0.09*hp.x-0.11*exp(min(leftD,0.0)/0.055);
    let capZ=0.76+0.14*exp(-pow((hp.y-2.0)/0.9,2.0))-0.05*hp.x-0.10*exp(min(capD,0.0)/0.055);
    let backZ= -0.30+0.29*sqrt(max(1.0-pow(max(backD+0.13,0.0)/0.13,2.0),0.0));
    if(backD<0.0 && backZ>hit.x){hit=vec2f(backZ,2.0);}
    if(leftD<0.002 && mainZ>hit.x){hit=vec2f(mainZ,2.0);}
    if(capD<0.002 && capZ>hit.x){hit=vec2f(capZ,2.0);}
  }
  if(p.y>0.70 && p.y<1.38 && abs(p.x)<1.0){
    let eyeD=min(av_path_avatar_sculpt(p,av_eyeLeft,av_eyeLeft_count),av_path_avatar_sculpt(p,av_eyeRight,av_eyeRight_count));
    let z=av_eye_surface_avatar_sculpt(p);
    // The face has a real socket cutout, so its old front surface cannot occlude the eye.
    if(eyeD<0.0 && (hit.y==1.0||z>hit.x)){hit=vec2f(z,3.0);}
    let up=av_lid_frame_avatar_sculpt(p,true);let down=av_lid_frame_avatar_sculpt(p,false);
    let upperZ=faceZ+av_upper_height_avatar_sculpt(up,av_lid_width_avatar_sculpt(p));
    let lowerZ=faceZ+av_lower_height_avatar_sculpt(down);
    if(up.x<select(av_lid_width_avatar_sculpt(p),0.100,up.y>0.0) && upperZ>hit.x){hit=vec2f(upperZ,14.0);}
    if(down.x<select(0.004,0.040,down.y>0.0) && lowerZ>hit.x){hit=vec2f(lowerZ,15.0);}
    let lash=av_lash_avatar_sculpt(p);
    if(lash<0.0 && faceZ+0.055>hit.x){hit=vec2f(faceZ+0.055,4.0);}
  }
  if(p.y>1.30 && p.y<1.70 && abs(p.x)<1.0){
    let browD=min(av_path_avatar_sculpt(p,av_browLeft,av_browLeft_count),av_path_avatar_sculpt(p,av_browRight,av_browRight_count));
    if(browD<0.0 && faceZ+0.021>hit.x){hit=vec2f(faceZ+0.021,12.0);}
  }
  if(p.x>0.45 && p.y<0.25){
    let handD=av_path_avatar_sculpt(p,av_hand,av_hand_count);
    let z=av_hand_surface_avatar_sculpt(p)-0.03*exp(min(handD,0.0)/0.03);
    if(handD<0.0 && z>hit.x){hit=vec2f(z,13.0);}
    let q=(p-vec2f(1.63,-0.63))/vec2f(0.28,0.30);
    if(dot(q,q)<1.0){hit=vec2f(0.70+0.10*sqrt(1.0-dot(q,q)),13.0);}
  }
  if(g>0.5){
    let q=(vec2f(abs(p.x),p.y)-vec2f(0.54,1.02))/vec2f(0.43,0.31);
    if(dot(q,q)<1.0 && 0.94>hit.x){hit=vec2f(0.94+0.045*sqrt(1.0-dot(q,q)),10.0);}
  }
  return hit;
}
// Differentiate the selected physical surface, so an occluding neighbour does
// not introduce a false normal on the eyeball or a flat fabric surface.
fn av_normal_height_avatar_sculpt(p: vec2f,id: f32,h: f32,g: f32) -> f32 {
  if(id==3.0){return av_eye_surface_avatar_sculpt(p);}
  if(id==14.0){return av_face_z_avatar_sculpt(p)+av_upper_height_avatar_sculpt(av_lid_frame_avatar_sculpt(p,true),av_lid_width_avatar_sculpt(p));}
  if(id==15.0){return av_face_z_avatar_sculpt(p)+av_lower_height_avatar_sculpt(av_lid_frame_avatar_sculpt(p,false));}
  if(id==7.0){return 0.23;}
  if(id==8.0){return 0.275;}
  return av_front_avatar_sculpt(p,h,g).x;
}
fn av_face_front_avatar_sculpt(p: vec2f) -> f32 {
  let d=av_path_avatar_sculpt(p,av_face,av_face_count);
  return av_face_z_avatar_sculpt(p)+av_nose_offset_avatar_sculpt(p)-0.07*exp(min(d,0.0)/0.06);
}
fn av_ear_front_avatar_sculpt(p: vec2f) -> f32 {
  let d=av_path_avatar_sculpt(p,av_ear,av_ear_count);
  return 0.45+0.16*sqrt(max(1.0-pow(max(d+0.18,0.0)/0.18,2.0),0.0));
}
fn av_pixel_avatar_sculpt(uv: vec2f,aspect: f32,pixelSize: f32,yaw: f32,pitch: f32,zoom: f32,s: f32,gaze: f32,h: f32,g: f32,clay: f32) -> vec4f {
  let a=clamp(yaw,-60.0,60.0)*0.01745329;
  let b=clamp(pitch,-20.0,20.0)*0.01745329;
  let focus=vec3f(-0.17,1.44,0.0);
  let xy=(uv-0.5)*vec2f(aspect,1.0)*4.0/clamp(zoom,0.7,1.3);
  let ro=focus+av_ry_avatar_sculpt(av_rx_avatar_sculpt(vec3f(xy,6.0),b),a);
  let rd=av_ry_avatar_sculpt(av_rx_avatar_sculpt(vec3f(0.0,0.0,-1.0),b),a);
  if(abs(yaw)<0.001 && abs(pitch)<0.001){
    let front=av_front_avatar_sculpt(ro.xy,h,g);
    if(front.y==0.0){return vec4f(av_linear_avatar_sculpt(vec3f(68.0,155.0,251.0)/255.0),1.0);}
    let e=0.003;
    let dx=av_normal_height_avatar_sculpt(ro.xy+vec2f(e,0.0),front.y,h,g)-av_normal_height_avatar_sculpt(ro.xy-vec2f(e,0.0),front.y,h,g);
    let dy=av_normal_height_avatar_sculpt(ro.xy+vec2f(0.0,e),front.y,h,g)-av_normal_height_avatar_sculpt(ro.xy-vec2f(0.0,e),front.y,h,g);
    var n=normalize(vec3f(-clamp(dx,-0.04,0.04),-clamp(dy,-0.04,0.04),2.0*e));
    if(front.y==1.0){
      if(av_path_avatar_sculpt(ro.xy,av_face,av_face_count)<0.0){
        let fx=av_face_front_avatar_sculpt(ro.xy+vec2f(e,0.0))-av_face_front_avatar_sculpt(ro.xy-vec2f(e,0.0));
        let fy=av_face_front_avatar_sculpt(ro.xy+vec2f(0.0,e))-av_face_front_avatar_sculpt(ro.xy-vec2f(0.0,e));
        n=normalize(vec3f(-fx,-fy,2.0*e));
      }else if(ro.y<0.18){
        n=normalize(vec3f(0.64*(ro.x+0.10)/0.36,0.0,1.0));
      }else{
        let ex=av_ear_front_avatar_sculpt(ro.xy+vec2f(e,0.0))-av_ear_front_avatar_sculpt(ro.xy-vec2f(e,0.0));
        let ey=av_ear_front_avatar_sculpt(ro.xy+vec2f(0.0,e))-av_ear_front_avatar_sculpt(ro.xy-vec2f(0.0,e));
        n=normalize(vec3f(-ex,-ey,2.0*e));
      }
    }
    if(front.y==4.0||front.y==12.0){n=normalize(vec3f(0.62*(ro.x+0.04)/1.0404,0.30*(ro.y-1.17)/1.5376,1.0));}
    return vec4f(av_shade_avatar_sculpt(vec3f(ro.xy,front.x),n,rd,front.y,s,h,g,gaze,clay),1.0);
  }
  var t=4.4;var found=false;var hit=vec2f(10.0,0.0);
  for(var i=0;i<220;i+=1) {
    hit=av_map_avatar_sculpt(ro+rd*t,s,h,g);
    if(hit.x<max(0.0008,pixelSize*0.22)){found=true;break;}
    t+=max(hit.x*0.50,0.0004);
    if(t>7.5){break;}
  }
  found=found||(t<7.5&&hit.x<pixelSize*0.6);
  var color=av_linear_avatar_sculpt(vec3f(68.0,155.0,251.0)/255.0);
  if(found){let p=ro+rd*t;let n=av_normal_avatar_sculpt(p,s,h,g);color=av_shade_avatar_sculpt(p,n,rd,hit.y,s,h,g,gaze,clay);}
  return vec4f(color,1.0);
}
fn shader_material_avatar_sculpt(in: ShaderMaterialInput,yaw: f32,pitch: f32,zoom: f32,smile: f32,gaze: f32,hairVolume: f32,sunglasses: f32,clay: f32) -> vec4f {
  var color=vec4f(0.0);
  for(var y=0;y<3;y+=1){for(var x=0;x<3;x+=1){
    let offset=(vec2f(f32(x),f32(y))-1.0)*0.8/in.geometry_size;
    let weight=select(1.0,2.0,x==1)*select(1.0,2.0,y==1);
    color+=weight*av_pixel_avatar_sculpt(in.uv+offset,in.geometry_size.x/in.geometry_size.y,4.0/(in.geometry_size.y*clamp(zoom,0.7,1.3)),
      yaw,pitch,zoom,smile,gaze,hairVolume,sunglasses,clay);
  }}
  return color/16.0;
}


 @vertex
 fn vs_main(
     @location(0) position: vec3f,
     @location(1) uv: vec2f,
 ) -> VSOut {
 var out: VSOut;

 let _unused_geo_size = params.geo_size;
 let _unused_geo_translate = params.geo_translate;
 let _unused_geo_scale = params.geo_scale;

 // UV passed as vertex attribute.
 out.uv = vec2f(uv.x, 1.0 - uv.y);

 out.geo_size_px = params.geo_size;
 // Geometry-local pixel coordinate (GeoFragcoord).
 out.local_px = vec3f(uv * out.geo_size_px, 0.0);

 var p_local = position;

 // Geometry vertices are in local pixel units centered at (0,0).
 // Convert to target pixel coordinates with bottom-left origin.
 out.local_px = vec3f(out.local_px.xy, p_local.z);
 let p_px = params.center + p_local.xy;

 out.position = params.camera * vec4f(p_px, p_local.z, 1.0);

 // Pixel-centered like GLSL gl_FragCoord.xy.
 out.frag_coord_gl = p_px + vec2f(0.5, 0.5);
 return out;
 }